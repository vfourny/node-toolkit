{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Language and Environment */
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Modules */
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["${configDir}/src/*"]
    },

    /* Interop Constraints */
    "isolatedModules": true,

    /* Emit: the bundler (Vite, ...) compiles the project, vue-tsc only type checks */
    "noEmit": true
  },
  "include": [
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/**/*.vue"
  ],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/coverage",
    "${configDir}/build"
  ]
}
