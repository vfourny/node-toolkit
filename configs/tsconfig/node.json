{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Modules: native Node.js ESM resolution, so tsc output runs as-is.
       Use package.json "imports" (e.g. "#src/*") for aliases: Node resolves them at runtime. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "${configDir}/src",
    "types": ["node"],

    /* Emit */
    "declaration": true,
    "outDir": "${configDir}/dist",
    "tsBuildInfoFile": "${configDir}/.cache/node.tsbuildinfo"
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
