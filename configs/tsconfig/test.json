{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Modules */
    "paths": {
      "@/*": ["${configDir}/src/*"],
      "@tests/*": ["${configDir}/tests/*"]
    },
    /* Test APIs are imported explicitly from vitest (globals disabled) */
    "types": ["node"],

    /* Emit */
    "noEmit": true,
    "tsBuildInfoFile": "${configDir}/.cache/test.tsbuildinfo"
  },
  "include": ["${configDir}/tests/**/*"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
