{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /* Language and Environment */
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Modules */
    "paths": {
      "@/*": ["${configDir}/src/*"]
    },
    "rootDir": "${configDir}/src",

    /* Interop Constraints */
    "isolatedModules": true,

    /* Emit */
    "declaration": true,
    "outDir": "${configDir}/dist",
    "tsBuildInfoFile": "${configDir}/.cache/react.tsbuildinfo"
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/coverage",
    "${configDir}/build"
  ]
}
